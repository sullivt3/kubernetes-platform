# Copy to .env and adjust. Never commit .env.

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

DATABASE_URL=postgresql+psycopg://kplatform:kplatform-dev-only@localhost:5432/kplatform
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000

# dev = every request runs as a local administrator (refused in staging/production)
# oidc = planned for Phase 7
AUTH_MODE=dev
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/platform
# OIDC_AUDIENCE=kubernetes-platform

# REQUIRED. Credential encryption keys as "key_id:fernet_key", comma-separated.
# The first key encrypts new secrets; older keys remain for decryption during rotation.
# Generate with:  python -m app.cli generate-key --key-id k1
SECRET_ENCRYPTION_KEYS=

# Orchestration tuning (seconds)
OPERATION_HEARTBEAT_SECONDS=15
OPERATION_STALE_AFTER_SECONDS=120
OPERATION_PENDING_REDISPATCH_SECONDS=60
OPERATION_MAX_RECOVERIES=3
