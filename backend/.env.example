# Copy to .env and adjust. Never commit .env.

# development | test | staging | production
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_JSON=false

# REQUIRED. Set a connection URL using your locally generated database password.
DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

CORS_ORIGINS=http://localhost:3000

# dev = every request runs as a local administrator (refused in staging/production)
# oidc = authorization-code/PKCE login and server-side browser sessions
AUTH_MODE=dev
# PUBLIC_URL=http://localhost:3000
# OIDC_ISSUER_URL=https://keycloak.example.com/realms/platform
# OIDC_CLIENT_ID=kubernetes-platform-web
# OIDC_AUDIENCE=kubernetes-platform-api
# OIDC_CLIENT_SECRET=          # omit for a public PKCE client
# OIDC_BOOTSTRAP_SUBJECT=      # trusted provider sub; first-user bootstrap only

# REQUIRED. Credential encryption keys as "key_id:fernet_key", comma-separated.
# The first key encrypts new secrets; older keys remain for decryption during rotation.
# Generate with:  python -m app.cli generate-key --key-id k1
SECRET_ENCRYPTION_KEYS=

# Authenticated machine connection checks (requires worker and beat)
MACHINE_PROBE_INTERVAL_SECONDS=30

# Platform recovery (see documentation/backup-restore.md)
# BACKUP_DIRECTORY=/var/lib/kplatform/backups
# BACKUP_RECIPIENT=age1...
# Optional for restoring a separate database from the GUI. Mount private files only on the worker.
# BACKUP_IDENTITY_FILE=/run/secrets/platform-recovery-identity
# RECOVERY_KEY_DIRECTORY=/var/lib/kplatform/recovered-keys

# Orchestration tuning (seconds)
OPERATION_HEARTBEAT_SECONDS=15
OPERATION_STALE_AFTER_SECONDS=120
OPERATION_PENDING_REDISPATCH_SECONDS=60
OPERATION_MAX_RECOVERIES=3

# Interactive Command Center is disabled until a trusted image is pinned.
# Build infrastructure/containers/command-runtime.Dockerfile and use its digest.
# COMMAND_CENTER_RUNTIME_IMAGE=registry.example.com/platform/command-runtime@sha256:<64-hex-manifest-digest>
# COMMAND_CENTER_KUBECTL_MINOR=37
