{
  "uid": "kplatform-node-metrics",
  "title": "Node metrics",
  "schemaVersion": 39,
  "editable": false,
  "tags": [
    "kubernetes",
    "kplatform"
  ],
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timezone": "browser",
  "panels": [
    {
      "id": 1,
      "title": "Node CPU",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kplatform-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(8, 100 * (1 - avg by (instance,node) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m]))))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "title": "Node memory",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "kplatform-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(8, max by (instance,node) (100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)))",
          "legendFormat": "",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ]
}
